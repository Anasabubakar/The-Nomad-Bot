# Copy to .env and fill in. Never commit the real .env.

# --- Required ---
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: core ---
# Defaults to nomad.db in the working directory.
# DB_PATH=/home/ubuntu/nomad-bot/nomad.db

# Telegram never shows a numeric user_id in its UI, so the founder is
# identified by @username on his FIRST DM to the bot. That DM pins his
# numeric id as the permanent owner; this value is not consulted again after
# that. Without it, no one can ever bind the owner role. Set without "@".
OWNER_USERNAME=davidnomad

# --- Optional: AI (owner assistant + community Q&A) ---
# Neither AI channel does anything until at least one provider key below is
# set. With none set, /announce, /stats, and /mystats still work normally —
# only the natural-language owner assistant and community Q&A are disabled.
#
# Provider order is fixed: Gemini, then Groq, then "custom", then anything in
# AI_PROVIDERS_JSON. Each request tries them in that order and falls back
# silently if one is down or rate-limited.

# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-flash-latest

# GROQ_API_KEY=your-groq-key
# GROQ_MODEL=openai/gpt-oss-20b

# Any OpenAI-compatible chat-completions endpoint. All three of these must be
# set together or the custom provider is ignored.
# CUSTOM_AI_BASE_URL=https://api.example.com/v1
# CUSTOM_AI_API_KEY=your-key
# CUSTOM_AI_MODEL=your-model-id

# Append further providers beyond the three named slots above, as a JSON
# array of {"name", "base_url", "api_key", "model", "timeout"?}.
# AI_PROVIDERS_JSON=[{"name":"backup","base_url":"https://...","api_key":"...","model":"..."}]

# --- Optional: destinations the owner assistant can post to ---
# Named delivery targets the owner's AI assistant can post to by name (e.g.
# "post this in Nomad Lounge"). A JSON array of
# {"key", "chat_id", "thread_id"?, "label"?}. thread_id is only needed for a
# topic inside a Telegram Forum group; omit it for an ordinary group chat.
# Without this set, the owner assistant can still DM known members and
# schedule tasks, but has nowhere configured to post group announcements to
# on its own initiative (the /announce command is unaffected — it always
# posts to the group it was run in).
# TARGET_CHATS_JSON=[{"key":"lounge","chat_id":-1001234567890,"label":"Nomad Lounge"},{"key":"event_drops","chat_id":-1001234567890,"thread_id":42,"label":"Event Drops"}]
